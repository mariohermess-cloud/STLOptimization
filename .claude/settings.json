{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/ablauf-erinnerung.sh\"", "timeout": 5 } ] }
    ],
    "PreToolUse": [
      { "matcher": "Edit|Write|MultiEdit", "hooks": [ { "type": "command", "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/claude-md-groesse.sh\"", "timeout": 10 } ] }
    ]
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./**/*.stl)",
      "Read(./**/*.3mf)",
      "Read(./frontend/node_modules/**)",
      "Read(./frontend/dist/**)",
      "Read(./build/**)",
      "Read(./dist/**)",
      "Read(./storage/**)",
      "Read(./.venv/**)"
    ]
  }
}
