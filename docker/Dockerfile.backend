# Print Engineering Optimizer - API
FROM python:3.12-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PEO_STORAGE_DIR=/data/uploads

WORKDIR /app

# trimesh, scipy, shapely and rtree ship manylinux wheels, so no compiler is
# needed. libspatialindex is the one runtime library rtree links against.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libspatialindex-c6 curl \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/app ./app

# Uploads live on a writable volume owned by an unprivileged user. Nothing
# from an uploaded file is ever executed, and storage keys are server
# generated UUIDs, so the container never opens a client supplied path.
RUN useradd --create-home --uid 10001 peo \
    && mkdir -p /data/uploads \
    && chown -R peo:peo /data
USER peo

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8000/health || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
