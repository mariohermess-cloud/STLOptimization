# Print Engineering Optimizer - API
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PEO_STORAGE_DIR=/data/uploads

WORKDIR /app

# No apt layer: every dependency ships a manylinux wheel, and the rtree wheel
# bundles libspatialindex itself, so there is no system library to install and
# no distribution package name to get wrong. The healthcheck uses the Python
# already in the image rather than pulling in curl.
COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/app ./app

# Uploads live on a writable volume owned by an unprivileged user. Nothing
# from an uploaded file is ever executed, and storage keys are server
# generated UUIDs, so the container never opens a client supplied path.
RUN useradd --create-home --uid 10001 peo \
    && mkdir -p /data/uploads \
    && chown -R peo:peo /data
USER peo

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD ["python", "-c", "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=4).status == 200 else 1)"]

# One worker on purpose: the model store is per process (see
# docs/architecture.md). Scaling out means shared storage, not more workers.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
