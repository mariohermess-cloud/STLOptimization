{
  "name": "Print Engineering Optimizer",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",

  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },

  "hostRequirements": { "cpus": 4, "memory": "8gb" },

  // Installs both toolchains so either way of running the app works:
  // scripts/dev.sh (uvicorn + Vite, fast to start) or docker compose.
  "postCreateCommand": "bash .devcontainer/setup.sh",

  "forwardPorts": [5173, 8000, 8080],
  "portsAttributes": {
    "5173": { "label": "Web UI (dev server)", "onAutoForward": "openBrowser" },
    "8000": { "label": "API", "onAutoForward": "silent" },
    "8080": { "label": "Web UI (docker compose)", "onAutoForward": "notify" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["backend"],
        "files.eol": "\n"
      }
    }
  },

  "remoteEnv": {
    // The orientation search is CPU bound; match the 4 cores requested above.
    "PEO_OPTIMIZER_WORKERS": "4",
    "PYTHONPATH": "${containerWorkspaceFolder}/backend"
  },

  "postAttachCommand": {
    "hint": "echo '\\nReady. Start the app with:  ./scripts/dev.sh\\nThen open the forwarded port 5173.\\nTests:  cd backend && python -m pytest -q\\n'"
  }
}
